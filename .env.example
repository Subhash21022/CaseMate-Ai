# ==============================================================================
# CaseMate AI — Environment Configuration Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Database Configuration
# Leave as default for local Docker MongoDB, or replace with your MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/casemate_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/casemate_ai

# Internal API Secret for n8n Webhook Authentications
INTERNAL_API_SECRET=casemate_dev_secret_key_892347

# n8n Orchestrator Configuration
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_PATH=/webhook/casemate-analysis

# AI Model Access (OpenRouter)
# Required for real AI extraction and legal document analysis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Supabase Storage & Auth (Optional Cloud Storage & Authentication)
# Provide your Supabase project keys to enable cloud file storage and user authentication.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=case-documents
