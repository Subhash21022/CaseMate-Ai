# CaseMate AI Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (Leave as local or provide MongoDB Atlas URI)
# If local MongoDB is not running, backend auto-spins an in-memory Mongo instance for development/testing
MONGODB_URI=mongodb://127.0.0.1:27017/casemate_ai

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Internal API Secret (Used to authenticate n8n workflow requests)
INTERNAL_API_SECRET=casemate_internal_secret_change_me_in_prod_892347

# n8n Orchestrator Configuration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook/casemate-analysis
N8N_USE_TEST_WEBHOOK=false

# OpenRouter AI Model Access
# Set your OpenRouter API key here. Used by backend agent services and n8n nodes.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
